{
  "compilerOptions": {
    /* Core Setup */
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],

    /* Node + Playwright */
    "types": ["node", "@playwright/test"],

    /* Paths */
    "rootDir": "./",
    "outDir": "./dist",

    /* Interop */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "tests",
    "utils",
    "playwright.config.ts"
  ]
}